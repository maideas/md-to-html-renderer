{
  "name": "pi-web-app",
  "label": "pi-web-app",
  "description": "Matches the chat content of pi-web-app (light and dark app themes). Colours extracted from pi-web-app's web/src/app.css; syntax tokens mirror highlight.js github / github-dark. Dark done-fg is lightened from --accent (#2B4A6F, 1.64:1 on the dark canvas) to #64809E to meet the contrast gate.",
  "base": {
    "font-body": "system-ui, sans-serif",
    "font-mono": "ui-monospace, monospace",
    "font-size": "16px",
    "font-size-code": "90%",
    "font-size-small": "13.6px",
    "line-height": "1.5",
    "line-height-code": "1.5",
    "radius": "6px",
    "radius-large": "8px",
    "border-accent-width": "0.25em",
    "space-block": "0.5em",
    "space-table-top": "1em",
    "space-table-bottom": "1em",
    "space-heading-top": "1em",
    "page-max-width": "none",
    "page-padding": "0",
    "h1-size": "1.4rem",
    "h2-size": "1.2rem",
    "h3-size": "1.1rem",
    "h4-size": "1rem",
    "h5-size": "0.95rem",
    "h6-size": "0.9rem",
    "h6-color": "var(--md-fg-default)",
    "heading-line-height": "1.3",
    "heading-underline-width": "0",
    "heading-underline-offset": "0"
  },
  "light": {
    "accent-emphasis": "#64809E",
    "accent-fg": "#0969da",
    "accent-muted": "#DCE5EF",
    "attention-emphasis": "#E5C97B",
    "attention-fg": "#6B5B2E",
    "attention-muted": "#FFF8E7",
    "border-default": "#E5E2DD",
    "border-muted": "#EFEDEA",
    "canvas-default": "#FFFFFF",
    "canvas-inset": "#F5F5F0",
    "canvas-subtle": "#F5F4F0",
    "danger-emphasis": "#A31B1B",
    "danger-fg": "#C41E3A",
    "diff-add-bg": "#DCEFE3",
    "diff-del-bg": "#F9DEDC",
    "done-emphasis": "#64809E",
    "done-fg": "#64809E",
    "fg-default": "#111111",
    "fg-muted": "#8A8580",
    "fg-on-emphasis": "#FFFFFF",
    "fg-subtle": "#B5B0AA",
    "neutral-muted": "#EFEDEA",
    "success-emphasis": "#1A8C4A",
    "success-fg": "#1A8C4A",
    "syn-brackethighlighter-unmatched": "#82071e",
    "syn-carriage-return-bg": "#cf222e",
    "syn-carriage-return-text": "#f6f8fa",
    "syn-comment": "#59636e",
    "syn-constant": "#0550ae",
    "syn-entity": "#6639ba",
