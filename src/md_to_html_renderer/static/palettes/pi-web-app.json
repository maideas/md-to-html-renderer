    "syn-keyword": "#cf222e",
    "syn-markup-bold": "#1f2328",
    "syn-markup-changed-bg": "#ffd8b5",
    "syn-markup-changed-text": "#953800",
    "syn-markup-deleted-bg": "#ffebe9",
    "syn-markup-deleted-text": "#82071e",
    "syn-markup-heading": "#0550ae",
    "syn-markup-ignored-bg": "#0550ae",
    "syn-markup-ignored-text": "#d1d9e0",
