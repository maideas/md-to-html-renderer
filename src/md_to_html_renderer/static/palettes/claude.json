{
  "name": "claude",
  "label": "Claude (pi-web-app)",
  "description": "Matches the claude theme of the pi-web-app chat UI: warm cream canvas, terracotta accent, rust links and inline code, serif headings, full-width tables with horizontal rules only. Syntax highlighting kept from the original approximation.",
  "base": {
    "font-body": "system-ui, sans-serif",
    "font-mono": "ui-monospace, monospace",
    "font-size": "16px",
    "font-size-code": "90%",
    "font-size-small": "12px",
    "line-height": "1.5",
    "line-height-code": "1.5",
    "radius": "6px",
    "radius-large": "8px",
    "border-accent-width": "0.2em",
    "space-block": "0.5em",
    "space-heading-top": "1em",
    "page-max-width": "784px",
    "page-padding": "32px 24px 64px",
    "h1-size": "1.4rem",
    "h2-size": "1.2rem",
    "h3-size": "1.1rem",
    "h4-size": "1rem",
    "h5-size": "0.95rem",
    "h6-size": "0.9rem",
    "h6-color": "var(--md-fg-default)",
    "heading-line-height": "1.3",
    "heading-underline-width": "0",
    "heading-underline-offset": "0",
    "space-table-top": "0.5em",
    "space-table-bottom": "0.5em",
    "heading-font": "ui-serif, Georgia, \"Times New Roman\", serif",
    "table-width": "100%",
    "table-cell-border": "none",
    "table-row-alt-bg": "var(--md-canvas-default)",
    "table-header-rule-width": "2px",
    "code-border": "1px solid var(--md-border-default)"
  },
  "light": {
    "canvas-default": "#F5F2EA",
    "canvas-subtle": "#EDE9DE",
    "canvas-inset": "#E7E2D4",
